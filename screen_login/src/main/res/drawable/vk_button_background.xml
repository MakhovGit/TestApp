        <shape android:shape="rectangle">
            <corners android:radius="@dimen/common_button_corner_radius" />
            <solid android:color="@color/button_ripple" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/common_button_corner_radius" />
                    <solid android:color="@color/vk_button" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
