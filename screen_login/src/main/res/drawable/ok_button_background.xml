<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@android:color/white">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/common_button_corner_radius" />
            <solid android:color="@color/button_ripple" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/common_button_corner_radius" />
                    <gradient
                        android:angle="@integer/fsl_gradient_angle"
                        android:endColor="@color/ok_button2"
                        android:gradientRadius="@integer/fsl_gradient_radius"
                        android:startColor="@color/ok_button1"
                        android:type="linear"
                        android:useLevel="false" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
