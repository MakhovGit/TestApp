<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fsa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:paddingHorizontal="@dimen/common_padding_horizontal">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/fsa_under_construction_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fsa_under_construction_text"
        android:textAlignment="center"
        android:textColor="@color/white_text"
        android:textSize="@dimen/fsa_under_construction_text_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>